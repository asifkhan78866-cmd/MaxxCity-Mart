# Copy to .env.local for local development and fill in real values.
# Never commit .env.local or paste real secrets into source files.

# --- Site ---------------------------------------------------------------
# Public URL of the live site, no trailing slash. Used for canonical URLs,
# the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Supabase (required in production) -----------------------------------
# Project URL and the SECRET / service-role key. Server-side only — never
# prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # legacy name, also accepted
SUPABASE_STORAGE_BUCKET=enquiry-uploads

# --- Email notifications via Resend (optional) ---------------------------
# When all three are set, each new submission emails the business.
RESEND_API_KEY=
# Comma-separated list of recipients.
NOTIFY_EMAIL_TO=
# Must be an address on a domain verified in Resend, e.g. "MaxxCity Mart Website <website@yourdomain.com>"
NOTIFY_EMAIL_FROM=

# --- Analytics (optional; loads only after the visitor accepts) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Google Search Console (optional) ------------------------------------
# The content value of the HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Local development only ----------------------------------------------
# Without Supabase, `npm run dev` saves submissions as JSON under .data/.
# Override the folder here if needed. Ignored in production builds.
# LOCAL_SUBMISSIONS_DIR=.data
